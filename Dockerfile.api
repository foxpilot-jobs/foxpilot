FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Some enterprise Docker proxies re-sign public TLS traffic. Normal public
# deployments should leave this empty and provide their CA bundle instead.
ARG PIP_TRUSTED_HOSTS="pypi.org files.pythonhosted.org"

COPY pyproject.toml requirements.txt README.md LICENSE ./
COPY src ./src
COPY services ./services
COPY alembic.ini ./alembic.ini
COPY alembic ./alembic

RUN for host in ${PIP_TRUSTED_HOSTS}; do TRUSTED_HOST_ARGS="$TRUSTED_HOST_ARGS --trusted-host $host"; done; \
    python -m pip install --no-cache-dir --index-url https://pypi.org/simple $TRUSTED_HOST_ARGS -e ".[api]" \
    && python -m playwright install --with-deps chromium

EXPOSE 8000

CMD ["sh", "-c", "alembic upgrade head && uvicorn services.api.app:app --host 0.0.0.0 --port 8000"]
