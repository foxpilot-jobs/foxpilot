## LLM provider. OpenAI is opt-in and receives resume/job text.
OPENAI_API_KEY=

## Use ollama for native local inference, or openai for the OpenAI API.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b

FOXPILOT_PUBLIC_URL=http://localhost:8080
CAREER_AGENT_ALLOWED_ORIGINS=http://localhost:8080

## Leave DATABASE_URL empty for the no-Docker SQLite workflow.
## Docker Compose supplies its PostgreSQL URL when this is empty.
POSTGRES_DB=foxpilot
POSTGRES_USER=foxpilot
POSTGRES_PASSWORD=foxpilot-dev-only
DATABASE_URL=

## Transactional email. Prefer Resend SMTP; keep the password/key secret.
EMAIL_FROM=FoxPilot <accounts@foxpilot.in>
RESEND_API_KEY=
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=resend
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_TLS=true

## Google OAuth web client. Register the exact callback URI:
## http://localhost:8080/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

## API authentication. Local mode is private and uses local-user.
FOXPILOT_ENV=local
FOXPILOT_AUTH_MODE=local
FOXPILOT_API_TOKEN=
FOXPILOT_TOKEN_USER_ID=staging-user

## Use native for a hosted/browser deployment; local keeps the private local-user identity.
## Native mode currently supports registration, login, logout, and database sessions.
