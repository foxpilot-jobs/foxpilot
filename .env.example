## Optional remote LLM provider. Local Ollama is the default and needs no key.
OPENAI_API_KEY=

## Runtime defaults (future package implementation will consume these).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b

## Optional integrations. Leave blank unless explicitly configured.
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=

## API authentication. Local mode is private and uses local-user.
FOXPILOT_ENV=local
FOXPILOT_AUTH_MODE=local
FOXPILOT_API_TOKEN=
FOXPILOT_TOKEN_USER_ID=staging-user
